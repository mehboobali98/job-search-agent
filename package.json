{
  "name": "job-search-agent",
  "version": "1.8.0",
  "description": "Reusable multi-agent job discovery, monitoring, claim-safe application intelligence, outcome calibration, and local tracking for Codex",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "create-tracker": "node scripts/create_tracker.mjs",
    "install-skill": "node scripts/install_skill.mjs",
    "config": "node scripts/export_search_config.mjs",
    "queries": "node scripts/build_search_queries.mjs",
    "eligibility": "node scripts/export_eligibility_evidence.mjs",
    "refresh-dashboard": "node scripts/refresh_dashboard.mjs Job_Application_Tracker.xlsx",
    "migrate-tracker": "node scripts/migrate_tracker.mjs --workbook Job_Application_Tracker.xlsx --state-dir state",
    "monitor": "node scripts/monitor_leads.mjs",
    "actions": "node scripts/refresh_actions.mjs",
    "lead": "node scripts/manage_lead.mjs",
    "outcome": "node scripts/record_application_outcome.mjs",
    "calibrate": "node scripts/calibrate_outcomes.mjs",
    "tailor": "node scripts/build_tailoring_report.mjs",
    "replay": "node scripts/replay_run.mjs",
    "compare-runs": "node scripts/compare_runs.mjs",
    "record-form": "node scripts/record_form_packet.mjs",
    "update": "node scripts/update_tracker.mjs",
    "inspect": "node scripts/inspect_workbook.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify-public": "node scripts/verify_public_repo.mjs"
  }
}

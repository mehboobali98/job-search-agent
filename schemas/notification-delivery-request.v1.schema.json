{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/job-search-agent/schemas/notification-delivery-request.v1.schema.json",
  "title": "Job Search Agent notification delivery request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "approval_id", "digest_id", "run_id", "created_at", "not_before", "destination", "items", "policy", "safety"],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "pattern": "^NREQ-[A-F0-9]{24}$" },
    "approval_id": { "type": "string", "pattern": "^NAPP-[A-F0-9]{24}$" },
    "digest_id": { "type": "string", "pattern": "^DIGEST-[A-F0-9]{24}$" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "created_at": { "type": "string", "format": "date-time" },
    "not_before": { "type": "string", "format": "date-time" },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "channel", "connection_ref"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "adapter": { "enum": ["private_file", "connector"] },
        "channel": { "enum": ["local", "email", "slack", "webhook", "custom"] },
        "connection_ref": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "job-digest.v1.schema.json#/$defs/item" }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_score", "max_items", "include_resume", "quiet_hours_applied", "deferred"],
      "properties": {
        "minimum_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "max_items": { "type": "integer", "minimum": 1, "maximum": 20 },
        "include_resume": { "type": "boolean" },
        "quiet_hours_applied": { "type": "boolean" },
        "deferred": { "type": "boolean" }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_explicit_approval", "external_delivery_performed", "application_submission_allowed", "recruiter_outreach_allowed", "credentials_included"],
      "properties": {
        "requires_explicit_approval": { "const": true },
        "external_delivery_performed": { "const": false },
        "application_submission_allowed": { "const": false },
        "recruiter_outreach_allowed": { "const": false },
        "credentials_included": { "const": false }
      }
    }
  }
}
